{
  "name": "obm-motion-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.cjs",
    "test:numerics": "node tests/numerics.mjs",
    "format": "prettier --write dashboard/*.{js,mjs,cjs,css,html} tests/*.{mjs,cjs}",
    "format:check": "prettier --check dashboard/*.{js,mjs,cjs,css,html} tests/*.{mjs,cjs}",
    "test:regressions": "node tests/regressions.cjs"
  },
  "dependencies": {
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "prettier": "3.9.9"
  }
}
